#!/bin/zsh

# -e: If a command has a non-zero exit status, execute the ZERR trap and exit.
# -u: Treat unset variables as an error when substituting.
# -o pipefail: Return exit status of last command in pipeline that failed.
set -euo pipefail

ROOT_DIR="$(git -C "${0:A:h}" rev-parse --show-toplevel)"
typeset -r PACKAGES_DIR="${ROOT_DIR}/packages"
typeset -A STOW_DESTINATIONS

STOW_DESTINATIONS=(
  [$HOME]="zsh git vim"
  [$HOME/.ssh]="ssh"
  [$HOME/.config]="starship"
  [$HOME/.claude]="agents/claude"
)


remove_path() {
  local path_to_remove="$1"

  rm -rf "${path_to_remove}"
  echo "Removed ${path_to_remove}"
}


prepare_destination() {
  local destination="$1"

  if [[ -e "${destination}" || -L "${destination}" ]] && [[ ! -d "${destination}" ]]; then
    remove_path "${destination}"
  fi

  mkdir -p "${destination}"
}


prepare_folder() {
  local folder="$1"

  if [[ -L "${folder}" ]] || { [[ -e "${folder}" ]] && [[ ! -d "${folder}" ]]; }; then
    remove_path "${folder}"
  fi
}


prepare_destination_file() {
  local source_file="$1"
  local destination_file="$2"

  if [[ -L "${destination_file}" ]] &&
     [[ "$(readlink "${destination_file}")" != /* ]] &&
     [[ "${destination_file:A}" == "${source_file:A}" ]]; then
    return 0
  elif [[ -e "${destination_file}" || -L "${destination_file}" ]]; then
    remove_path "${destination_file}"
  fi
}


link_package() {
  local destination="$1"
  local package_location="$2"
  local source_file relative_path folder part
  local -a parts

  prepare_destination "${destination}"

  for source_file in ${(f)"$(find "${package_location}" \( -type f -o -type l \))"}; do
    relative_path="${source_file#${package_location}/}"
    parts=(${(s:/:)relative_path})
    folder="${destination}"

    for part in ${parts[1,-2]}; do
      folder+="/${part}"
      prepare_folder "${folder}"
    done

    prepare_destination_file "${source_file}" "${destination}/${relative_path}"
  done

  stow --restow --no-folding --dir="${package_location:h}" --target="${destination}" "${package_location:t}"
}


echo "Linking dotfiles..."

for destination in ${(k)STOW_DESTINATIONS}; do
  for package_path in ${(z)STOW_DESTINATIONS[$destination]}; do
    link_package "${destination}" "${PACKAGES_DIR}/${package_path}"
  done
done

echo "Done."
