#!/bin/zsh

# -e: If a command has a non-zero exit status, execute the ZERR trap and exit.
# -u: Treat unset variables as an error when substituting.
# -o pipefail: Return exit status of last command in pipeline that failed.
set -euo pipefail

typeset -r ROOT_DIR="${0:A:h:h}"
typeset -A STOW_DESTINATIONS

STOW_DESTINATIONS=(
  [$HOME]="zsh config/git config/vim"
  [$HOME/.ssh]="config/ssh"
  [$HOME/.config]="config/starship"
  [$HOME/.claude]="agents/claude"
)


remove_path() {
  local target="$1"

  rm -rf "${target}"
  echo "Removed ${target}"
}


prepare_destination() {
  local destination="$1"

  if [[ -e "${destination}" || -L "${destination}" ]] && [[ ! -d "${destination}" ]]; then
    remove_path "${destination}"
  fi

  mkdir -p "${destination}"
}


prepare_folder() {
  local folder="$1"

  if [[ -L "${folder}" ]] || { [[ -e "${folder}" ]] && [[ ! -d "${folder}" ]]; }; then
    remove_path "${folder}"
  fi
}


prepare_target() {
  local source_file="$1"
  local target="$2"

  if [[ -L "${target}" ]] && [[ "$(readlink "${target}")" != /* ]] && [[ "${target:A}" == "${source_file}" ]]; then
    return 0
  elif [[ -e "${target}" || -L "${target}" ]]; then
    remove_path "${target}"
  fi
}


link_package() {
  local destination="$1"
  local package_location="$2"
  local source_file relative_path folder part
  local -a parts

  prepare_destination "${destination}"

  for source_file in ${(f)"$(find "${package_location}" -type f)"}; do
    relative_path="${source_file#${package_location}/}"
    parts=(${(s:/:)relative_path})
    folder="${destination}"

    for part in ${parts[1,-2]}; do
      folder+="/${part}"
      prepare_folder "${folder}"
    done

    prepare_target "${source_file}" "${destination}/${relative_path}"
  done

  stow --restow --no-folding --dir="${package_location:h}" --target="${destination}" "${package_location:t}"
}


echo "Linking dotfiles..."

for destination in ${(k)STOW_DESTINATIONS}; do
  for package_path in ${(z)STOW_DESTINATIONS[$destination]}; do
    link_package "${destination}" "${ROOT_DIR}/${package_path}"
  done
done

echo "Done."
