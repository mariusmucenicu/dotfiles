prune_git_stale_branches() {
  # This function removes both stale remote-tracking references and their
  # corresponding local branches to keep your repository clean.

  # Usage
  # prune_git_stale_branches [remote]
  #   remote: The remote repository name (defaults to 'origin').

  # Example
  # prune_git_stale_branches
  # prune_git_stale_branches upstream

  setopt localoptions errreturn

  local remote=${1:-origin}
  local stashed_changes=false
  local stashed_msg="You have stashed changes. Make sure to pop or drop them."
  local default_branch local_branch remote_state
  local -a stale_branches

  typeset -r format="%(refname:short) %(upstream:track,nobracket)"
  typeset -r current_branch="$(git branch --show-current)"

  git remote prune $remote > /dev/null

  while read -r local_branch remote_state; do
    [[ $remote_state == "gone" ]] && stale_branches+=($local_branch)
  done < <(git for-each-ref --format=${format} refs/heads)

  if (( ${#stale_branches} == 0 )); then
    echo "Everything is up to date."
    return 0
  fi

  if (( ${stale_branches[(Ie)$current_branch]} )); then
    default_branch="$(git symbolic-ref --short refs/remotes/${remote}/HEAD)"

    if [[ -n $(git status --short) ]]; then
      git stash -u > /dev/null
      stashed_changes=true
    fi

    git switch --quiet ${default_branch#${remote}/}
  fi

  git branch -D "${stale_branches[@]}" > /dev/null

  if [[ $stashed_changes == "true" ]]; then
    echo "Total pruned branches: ${#stale_branches}\n${stashed_msg}"
  else
    echo "Total pruned branches: ${#stale_branches}"
  fi
}


prune_git_untracked_remotes() {
  # This function scans all remote‑tracking references and deletes any
  # remote/<branch> where there is no corresponding local branch <branch>.
  # It keeps your remote‑tracking list in sync with your local branches.

  # Usage
  # prune_git_untracked_remotes [remote]
  #   remote: The remote repository name (defaults to 'origin').

  # Example
  # prune_git_untracked_remotes
  # prune_git_untracked_remotes upstream

  setopt localoptions errreturn

  local remote=${1:-origin}
  local remote_branch
  local -a local_branches untracked_remotes

  local_branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads)"})

  while read -r remote_branch; do
    [[ $remote_branch == "HEAD" ]] && continue
    (( ${local_branches[(Ie)$remote_branch]} )) || untracked_remotes+=(${remote}/${remote_branch})
  done < <(git for-each-ref --format='%(refname:lstrip=3)' refs/remotes/${remote})

  if (( ${#untracked_remotes} == 0 )); then
    echo "Everything is up to date."
    return 0
  fi

  git branch -r -d "${untracked_remotes[@]}" > /dev/null
  echo "Total pruned branches: ${#untracked_remotes}"
}
